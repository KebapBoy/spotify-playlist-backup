TZ=Europe/Berlin
SPOTIFY_PLAYLIST_BACKUP_CLIENT_ID=
SPOTIFY_PLAYLIST_BACKUP_CLIENT_SECRET=
SPOTIFY_PLAYLIST_BACKUP_REDIRECT_URI=https://127.0.0.1/callback
SPOTIFY_PLAYLIST_BACKUP_RUN_ON_STARTUP=false
# host directory with config.yml; also holds the Spotify token and status.json
SPOTIFY_PLAYLIST_BACKUP_DATA_DIR=./data
